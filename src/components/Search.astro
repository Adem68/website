---
import "@pagefind/default-ui/css/ui.css";
import IconSearch from "@/assets/icons/IconSearch.svg";
---

<site-search id="search-block" class="block">
  <button
    data-open-modal
    class="focus-outline flex size-9 items-center justify-center rounded-full p-1 sm:p-1"
    aria-label="search"
    title="Search"
  >
    <IconSearch class="size-6 scale-125 stroke-current stroke-2 sm:scale-110" />
    <span class="sr-only">Search</span>
  </button>

  <dialog
    aria-label="search"
    class="h-full max-h-full w-full max-w-full translate-y-4 border border-border bg-white shadow-2xl transition-all duration-300 ease-in-out backdrop:backdrop-blur-sm open:translate-y-0 open:opacity-100 sm:mx-auto sm:mt-16 sm:mb-auto sm:h-max sm:max-h-[calc(100%-8rem)] sm:min-h-[15rem] sm:w-5/6 sm:max-w-[48rem] sm:rounded-md dark:bg-neutral-900"
  >
    <div class="dialog-frame flex h-full flex-col gap-4 overflow-hidden p-6">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold text-foreground">Search</h2>
        <button
          data-close-modal
          class="ms-auto cursor-pointer rounded-full bg-muted p-2 text-foreground/50 hover:text-foreground"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-6 stroke-current stroke-2"
            fill="none"
            viewBox="0 0 24 24"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div id="pagefind-search" class="search-container overflow-y-auto pr-2">
      </div>
    </div>
  </dialog>
</site-search>

<script>
  class SiteSearch extends HTMLElement {
    constructor() {
      super();
      const openBtn = this.querySelector<HTMLButtonElement>(
        "button[data-open-modal]"
      );
      const closeBtn = this.querySelector<HTMLButtonElement>(
        "button[data-close-modal]"
      );
      const dialog = this.querySelector("dialog");
      const dialogFrame = this.querySelector(".dialog-frame");

      if (openBtn) {
        openBtn.disabled = false;
        openBtn.addEventListener("click", () => {
          dialog?.showModal();
          // Initialize search only when opened to save resources
          this.initSearch();
          // Prevent body scroll
          document.body.classList.add("overflow-hidden");

          // Focus input slightly after transition ends
          setTimeout(() => {
            const input = dialog?.querySelector("input");
            if (input) input.focus();
          }, 100);
        });
      }

      if (closeBtn) {
        closeBtn.addEventListener("click", () => this.closeModal(dialog));
      }

      dialog?.addEventListener("click", event => {
        if (!dialogFrame?.contains(event.target as Node)) {
          this.closeModal(dialog);
        }
      });

      dialog?.addEventListener("close", () => {
        document.body.classList.remove("overflow-hidden");
      });

      // Close on 'Escape' key for accessibility
      window.addEventListener("keydown", e => {
        if (e.key === "Escape" && dialog?.open) {
          this.closeModal(dialog);
        }

        // Command+K to open
        if ((e.metaKey || e.ctrlKey) && e.key === "k") {
          e.preventDefault();
          if (!dialog?.open) {
            openBtn?.click();
          } else {
            this.closeModal(dialog);
          }
        }
      });
    }

    closeModal(dialog: HTMLDialogElement | null) {
      dialog?.close();
    }

    async initSearch() {
      const searchDiv = this.querySelector("#pagefind-search");
      if (!searchDiv || searchDiv.innerHTML.trim() !== "") return;

      const { PagefindUI } = await import("@pagefind/default-ui");

      if (import.meta.env.DEV) {
        searchDiv.innerHTML = `
            <div class="bg-muted/75 rounded p-4 space-y-4 mb-4">
              <p><strong>DEV mode Warning:</strong> Run <code>bun run build</code> to generate search index.</p>
            </div>
          `;
      }

      new PagefindUI({
        element: "#pagefind-search",
        showSubResults: true,
        showImages: false,
        resetStyles: false,
        openFilters: ["Tag", "Tags"],
      });
    }
  }

  customElements.define("site-search", SiteSearch);
</script>

<style is:global>
  #pagefind-search {
    --pagefind-ui-scale: 1;
    --pagefind-ui-font: inherit;
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: transparent;
    --pagefind-ui-border: var(--border);
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-tag: var(--muted);
    --pagefind-ui-border-radius: 0.5rem;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-image-border-radius: 8px;
  }

  #pagefind-search .pagefind-ui__drawer {
    gap: 1.5rem; /* fix spacing */
  }

  #pagefind-search form::before {
    background-color: var(--foreground);
    opacity: 0.5;
  }

  #pagefind-search input {
    background-color: var(--muted);
    font-weight: 400;
    border: 1px solid var(--border);
    padding: 0.75rem 4rem !important; /* Larger horizontal padding, smaller vertical */
    border-radius: 0.5rem;
    font-size: 1.1rem;
  }

  #pagefind-search form {
    margin-left: 0.5rem;
    margin-right: 0.5rem;
    margin-bottom: 1rem;
  }

  #pagefind-search input:focus-visible {
    outline: 2px solid var(--accent);
    border-color: transparent;
  }

  #pagefind-search .pagefind-ui__result-title a {
    color: var(--accent);
    font-weight: 600;
  }

  #pagefind-search .pagefind-ui__result-excerpt {
    color: var(--foreground);
    opacity: 0.8;
  }

  /* Hide the "Filters" button default UI if not needed or style it */
  #pagefind-search .pagefind-ui__button {
    background: var(--muted);
    color: var(--foreground);
    border: 1px solid var(--border);
  }
</style>
